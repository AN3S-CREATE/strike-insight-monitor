                "id": "f9e0d1c2-3456-7890-1234-ef1234567890",
                "text": {
                  "ops": [
                    {
                      "insert": "Argument 2: Protected Strike Activity",
                      "attributes": {}
                    },
                    {
                      "insert": "\n",
                      "attributes": {
                        "paragraph": true
                      }
                    }
                  ]
                },
                "format": {
                  "node": "checkbox",
                  "children": null
                },
                "collapsed": false,
                "completed": false,
                "children": [
                  {
                    "type": "text",
                    "id": "a0f1e2d3-4567-8901-2345-f12345678901",
                    "text": {
                      "ops": [
                        {
                          "insert": "Legal Basis:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Section 67 LRA (right to strike); Section 5 LRA (no dismissal for protected strike)",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
                      "children": null
                    },
                    "collapsed": false,
                    "completed": false,
                    "children": []
                  },
                  {
                    "type": "text",
                    "id": "b1a2f3e4-5678-9012-3456-a12345678912",
                    "text": {
                      "ops": [
                        {
                          "insert": "Precedent:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Food & Allied Workers Union v Premier Foods (2010) ZALC 96 — Strike was procedurally protected",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
                      "children": null
                    },
                    "collapsed": false,
                    "completed": false,
                    "children": []
                  },
                  {
                    "type": "text",
                    "id": "c2b3a4f5-6789-0123-4567-b12345678923",
                    "text": {
                      "ops": [
                        {
                          "insert": "Core Argument:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Strike complied with Section 64 notice requirements; wage demands are legitimate; dismissal retaliates against constitutional right",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
                      "children": null
                    },
                    "collapsed": false,
                    "completed": false,
                    "children": []
                  },
                  {
                    "type": "text",
                    "id": "d3c4b5a6-7890-1234-5678-c12345678934",
                    "text": {
                      "ops": [
                        {
                          "insert": "Strength: Strong",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " — If strike was protected, dismissal is automatically unfair per Section 187(1)(c)",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
