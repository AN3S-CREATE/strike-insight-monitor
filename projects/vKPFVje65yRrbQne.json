                    "type": "text",
                    "id": "c8b9a0f1-2345-6789-0123-b12345678989",
                    "text": {
                      "ops": [
                        {
                          "insert": "Core Argument:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Prolonged strike caused financial collapse; mine unviable; consultation conducted; no alternative to dismissals",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
