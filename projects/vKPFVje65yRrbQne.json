                    "text": {
                      "ops": [
                        {
                          "insert": "Legal Basis:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Section 67(5)-(8) LRA (strike limitations); common law dismissal for serious misconduct",
