                "text": {
                  "ops": [
                    {
                      "insert": "Argument 1: Procedural Unfairness",
                      "attributes": {}
                    },
                    {
                      "insert": "\n",
                      "attributes": {
                        "paragraph": true
                      }
                    }
                  ]
                },
                "format": {
                  "node": "checkbox",
                  "children": null
                },
                "collapsed": false,
                "completed": false,
                "children": [
                  {
                    "type": "text",
                    "id": "b5a6f7e8-9012-3456-7890-abcdef123456",
                    "text": {
                      "ops": [
                        {
                          "insert": "Legal Basis:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Section 188(1)(b) LRA; Item 4 Code of Good Practice: Dismissal",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
                      "children": null
                    },
                    "collapsed": false,
                    "completed": false,
                    "children": []
                  },
                  {
                    "type": "text",
                    "id": "c6b7a8f9-0123-4567-8901-bcdef1234567",
                    "text": {
                      "ops": [
                        {
                          "insert": "Precedent:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " NUMSA v Macsteel (2019) ZALCJHB 145 — Employer must follow fair procedure even during strikes",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
                      "children": null
                    },
                    "collapsed": false,
                    "completed": false,
                    "children": []
                  },
                  {
                    "type": "text",
                    "id": "d7c8b9a0-1234-5678-9012-cdef12345678",
                    "text": {
                      "ops": [
                        {
                          "insert": "Core Argument:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Employer failed to conduct individual disciplinary hearings; dismissed en masse without assessing individual culpability; no opportunity to make representations",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
                      "children": null
                    },
                    "collapsed": false,
                    "completed": false,
                    "children": []
                  },
                  {
                    "type": "text",
                    "id": "e8d9c0b1-2345-6789-0123-def123456789",
                    "text": {
                      "ops": [
                        {
                          "insert": "Strength: Strong",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " — Procedural fairness is mandatory; employer burden to prove compliance",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
                          }
                        }
                      ]
                    },
                    "format": {
                      "node": "text",
