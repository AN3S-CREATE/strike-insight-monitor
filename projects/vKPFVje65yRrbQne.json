                    "text": {
                      "ops": [
                        {
                          "insert": "Strength: Moderate",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " — Requires proof of genuine operational need; burden on employer; retrenchment vs dismissal distinction critical",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
