                    "text": {
                      "ops": [
                        {
                          "insert": "Core Argument:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " If workers engaged in violence, intimidation, or property damage, strike loses protection; dismissal justified for misconduct",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
