                    "text": {
                      "ops": [
                        {
                          "insert": "Precedent:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Fry's Metals v NUMSA (2003) ZALC 39 — Economic duress may justify retrenchment",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
