                    "text": {
                      "ops": [
                        {
                          "insert": "Precedent:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " SATAWU v Garvas (2012) ZACC 13 — Violence/intimidation removes strike protection",
                          "attributes": {}
                        },
                        {
                          "insert": "\n",
                          "attributes": {
                            "paragraph": true
