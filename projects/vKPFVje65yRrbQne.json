                    "text": {
                      "ops": [
                        {
                          "insert": "Legal Basis:",
                          "attributes": {
                            "bold": true
                          }
                        },
                        {
                          "insert": " Section 189 LRA (operational requirements dismissal); Section 188(1)(a)(ii)",
