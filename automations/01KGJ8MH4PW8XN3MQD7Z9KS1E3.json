{
  "version": "2",
  "flowTitle": "30-Min Strike Updates",
  "trigger": {
    "valid": true,
    "displayName": "Every Hour",
    "type": "PIECE_TRIGGER",
    "settings": {
      "pieceName": "@taskade/automade-internalpiece-schedule",
      "pieceVersion": "1.0.0",
      "triggerName": "schedule.hourly",
      "input": {}
    }
  },
  "actions": [
    {
      "name": "c7d8e9f0-1234-5678-90ab-cdef12345678",
      "valid": true,
      "displayName": "Search for Strike Updates",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-media",
        "pieceVersion": "1.0.0",
        "actionName": "web.search",
        "input": {
          "query": "Middelburg Mpumalanga Liberty Coal strike protest latest"
        }
      }
    },
    {
      "name": "d8e9f0a1-2345-6789-abcd-ef1234567890",
      "valid": true,
      "displayName": "Analyze Results",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-openai",
        "pieceVersion": "1.0.0",
        "actionName": "ai.ask",
        "input": {
          "input": "{{ c7d8e9f0-1234-5678-90ab-cdef12345678[\"summary\"] }}",
          "prompt": "Analyze these search results for NEW developments about the Middelburg strike. Compare with what we already know. Extract: 1) Any breaking news 2) New statements from stakeholders 3) Court updates 4) Changes in protest activity. If nothing new, say 'No significant updates'. Format as bullet points."
        }
      }
    },
    {
      "name": "e9f0a1b2-3456-789a-bcde-f123456789ab",
      "valid": false,
      "displayName": "Store in Database",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-taskade",
        "pieceVersion": "1.0.0",
        "actionName": "task.create",
        "input": {
          "content": "Update: {{ d8e9f0a1-2345-6789-abcd-ef1234567890[\"result\"] }}",
          "projectId": {
            "type": "flow-template-variable-input-type",
            "id": "5sa8Yq2UKJGssX9c"
          }
        }
      }
    },
    {
      "name": "f0a1b2c3-4567-890a-bcde-f12345678901",
      "valid": true,
      "displayName": "Check if Updates Found",
      "type": "BRANCH",
      "settings": {},
      "paths": [
        {
          "name": "a1b2c3d4-5678-90ab-cdef-123456789012",
          "valid": true,
          "displayName": "New Updates Found",
          "type": "BRANCH_PATH",
          "settings": {
            "ruleset": {
              "type": "CUSTOM",
              "input": {
                "type": "or",
                "value": [
                  {
                    "type": "and",
                    "value": [
                      {
                        "condition": "text_is_not_empty",
                        "id": "66299427-8d86-496d-900c-8f9c11785085",
                        "data": "{{ d8e9f0a1-2345-6789-abcd-ef1234567890[\"result\"] }}",
                        "comparator": ""
                      }
                    ]
                  }
                ]
              }
            }
          },
          "actions": [
            {
              "name": "b2c3d4e5-6789-abcd-ef12-345678901234",
              "valid": false,
              "displayName": "Send Email Alert",
              "type": "PIECE",
              "settings": {
                "pieceName": "@taskade/automade-piece-gmail",
                "pieceVersion": "1.0.0",
                "actionName": "sendEmail",
                "input": {
                  "to": "create@an3s.info",
                  "subject": "🚨 Strike Monitor Alert: New Developments",
                  "bodyHtml": "<h2>New Strike Developments Detected</h2><p><strong>Time:</strong> {{ trigger[\"triggerTime\"] }}</p><h3>Analysis:</h3><p>{{ d8e9f0a1-2345-6789-abcd-ef1234567890[\"result\"] }}</p><hr/><p><a href='https://www.taskade.com/d/5sa8Yq2UKJGssX9c'>View Full Intelligence Database</a></p>"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "variables": {
    "5sa8Yq2UKJGssX9c": {
      "id": "5sa8Yq2UKJGssX9c",
      "rank": "V",
      "type": "string",
      "format": "taskade-project-id"
    }
  }
}